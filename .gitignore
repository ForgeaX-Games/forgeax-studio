# Local scratch space (never tracked at parent level)
_drafts/

# Root apps/ was removed — ignore if tooling recreates it (e.g. stray Vite output).
/apps/

# Secrets — even though sub-repos have their own .gitignore, defense-in-depth
.env
.env.*
!.env.example
*.key
key.txt
llm_key.json
github-info.txt

# Build/runtime artifacts
*.log
# Ignore dependency directories and worktree-sharing symlinks.
node_modules
.forgeax/
/projects/
/state/
/workspace.json
# .forgeax-harness is a floating clone of forgeax-studio-harness (closed-loop
# state only), NOT a submodule and NEVER tracked here. Do not force-add loop
# state or source docs from this directory. The no-slash pattern also protects
# a local symlink used to point at an alternate clone.
# Materialised by scripts/sync-harness.mjs (npm run harness:sync / bootstrap.sh /
# deploy.sh).
/.forgeax-harness
# Studio source docs, rules, and skills live in the root forgeax-harness
# repository and are consumed through packages/harness. Keep stale local mounts
# out of the root tree; CI also rejects force-added copies.
/rules
/skills
.self-evolve/
.playwright-mcp/
# playwright-cli session scratch (console logs, snapshot yml, screenshots).
# Produced by forgeax-visual + forgeax-harness/playwright-cli when an agent
# drives a browser. Per-session files (`console-<ts>.log`, `page-<ts>.yml`),
# never useful across sessions.
.playwright-cli/
.forgeax.legacy-backup-*.tar.gz
games/
test-results/
__pycache__/

# Editor scratch
.vscode/
.idea/
*.swp
.DS_Store
.worktrees/
.bc/
.claude/
# Ad-hoc screenshots dropped at repo root during dev/debug
/wb-*.png
/agent-*.png
/matrix-*.png
MyFile
# 3d-lowpoly agent runtime byproducts + TLS cert export (generated)
/assets/
/library/
forgeax-studio-ca.crt
# Local-only patches handed back to other submodule owners (never upstream)
/.local-patches/
.env8888

# studio-qa automated-test artifacts (screenshots + reports)
/.forgeax-qa/

# studio build output (regenerated)
/packages/studio/dist/
# RHI debug reports/tapes are runtime evidence, never source.
/packages/studio/.forgeax-debug/
/packages/npc-client/dist/
packages/editor
packages/marketplace
packages/server

# parallel-track floating clones (own .git, may hold unpushed work — NOT regenerated, do not delete)
# engine = forgeax-engine checkout; kernel = backend-foundation container (platform-io). Neither is a
# workspace or submodule of this repo; see plan "Reconciliation results (2026-07-02)".
packages/engine/
packages/kernel/

# forgeax-harness is a floating runtime-tool checkout, not a Studio gitlink.
# `bun install`/`bun fx setup` materialises it when missing; `bun fx update`
# refreshes it only when the checkout already exists.
/packages/harness

# forgeax-games is an optional consumer checkout, not part of Studio's pinned
# source graph. Materialise it only for local game-library work; CI sets
# FORGEAX_SKIP_GAMES=1 and never clones it.
/packages/games/

# brainstorming visual companion mockups
.superpowers/

# Verify skill smoke-test screenshots (transient)
smoke-*.png
# === 2026-07-05: local-only content (user-directed) ===

# packages/kernel/ — local clone of forgeax-kernel (active platform-io dev);
# not a registered submodule. Keep local, don't clutter status.
/packages/kernel/

# Local analysis / handoff / memory docs (not repo content)
/outputs/
/.workbuddy/

# Local-only helper scripts (not for upstream)
/scripts/build-desktop.sh
/scripts/gen-hellforge-scene-assets.sh
/scripts/gen-hellforge-scene-assets.py

# .cursor/skills/* — local symlinks into vendored skills/ + harness + ~/.cc-switch
# (machine-specific paths, not committable).
/.cursor/skills/*

# Misc dev artifacts
/turnaround-front-view.png
/turnaround-front.png
/warrior-npu6-req.json
/.tsc-out.txt
