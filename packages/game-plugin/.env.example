# @forgeax/game — environment template
#
# Copy this file to `.env` and fill in the values, then source it into the environment
# that launches the MCP server (or export the variables another way). `.env` is
# gitignored; never commit real keys. Rotate any secret that has been shared or leaked.
#
#   cp .env.example .env && $EDITOR .env
#
# Only the asset-generation tools (forgeax_generate_image / forgeax_generate_3d) need
# these; the rest of the plugin runs without any of them.

# ── LiteLLM gateway (image + 3D generation) ─────────────────────────────────────
# Required for both generation tools. The key is a secret.
FORGEAX_LITELLM_API_KEY=sk-your-litellm-key
# Required for generation tools. Set this to the LiteLLM gateway provided by your deployment.
FORGEAX_LITELLM_BASE_URL=https://litellm.example.com

# Asset3D defaults to the public AW provider. If selecting the EA provider, its gateway
# must be explicitly configured; no internal endpoint is bundled with this package.
# FORGEAX_ASSET_LIBRARY=ea
# FORGEAX_ASSET_LIBRARY_BASE_URL=https://asset-library.example.com

# Optional model overrides (defaults shown).
# FORGEAX_GEN_IMAGE_MODEL=gemini-3-pro-image
# FORGEAX_GEN_3D_TEXT_MODEL=tripo-3d-text
# FORGEAX_GEN_3D_IMAGE_MODEL=tripo-3d-image

# ── COS object storage (only for image-to-3D from a LOCAL image file) ────────────
# When set, a local image passed to forgeax_generate_3d is uploaded to this bucket and
# handed to the backend as a short-lived presigned URL. Leave unset to require a public
# https image URL instead. SECRET_ID / SECRET_KEY are secrets.
# FORGEAX_COS_BUCKET=your-bucket-1300000000
# FORGEAX_COS_REGION=ap-guangzhou
# FORGEAX_COS_SECRET_ID=your-cos-secret-id
# FORGEAX_COS_SECRET_KEY=your-cos-secret-key

# ── Project resolution (optional) ────────────────────────────────────────────────
# Force which ForgeaX project the server operates on. Defaults to walking up from cwd.
# FORGEAX_PROJECT_ROOT=/absolute/path/to/your/project
