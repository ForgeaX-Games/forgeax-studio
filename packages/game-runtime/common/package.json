{
  "name": "@forgeax/game-runtime-common",
  "version": "0.3.31",
  "description": "Shared verified Runtime installation, launch, and Engine SDK APIs for ForgeaX platform packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
