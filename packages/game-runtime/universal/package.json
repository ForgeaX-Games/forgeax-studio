{
  "name": "@forgeax/game-runtime",
  "version": "0.3.31",
  "description": "Platform-selecting Universal entry for ForgeaX Game Runtime packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "optionalDependencies": {
    "@forgeax/game-runtime-darwin-arm64": "0.3.31",
    "@forgeax/game-runtime-win32-x64": "0.3.31",
    "@forgeax/game-runtime-linux-x64": "0.3.31"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "prepack": "node build.mjs"
  }
}
