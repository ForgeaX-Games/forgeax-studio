{
  "specVersion": 1,
  "manifestVersion": "recursive-input-ci.v1",
  "outputContractVersion": "recursive-input-ci-result.v1",
  "scope": "recursive-input-direct-consumers",
  "producers": [
    {
      "producerId": "fetch-submodules-ordinary",
      "owner": ".github/actions/fetch-submodules/action.yml",
      "inputClasses": ["source", "large-file-storage"],
      "trustScopes": ["ordinary-ci"],
      "outputContractVersion": "recursive-input-ci-result.v1"
    },
    {
      "producerId": "fetch-submodules-trusted",
      "owner": ".github/actions/fetch-submodules/action.yml",
      "inputClasses": ["source", "large-file-storage"],
      "trustScopes": ["trusted-base-ci"],
      "outputContractVersion": "recursive-input-ci-result.v1"
    }
  ],
  "consumers": [
    {
      "consumerId": "nightly-e2e",
      "producerId": "fetch-submodules-ordinary",
      "trustScope": "ordinary-ci",
      "workflow": ".github/workflows/nightly-e2e.yml",
      "job": "contract",
      "validationBoundary": "before first source-owned command",
      "sourceWork": "bun install"
    }
  ],
  "requiredContexts": [
    {
      "name": "typecheck + build + script smoke",
      "source": ".github/workflows/ci.yml",
      "job": "check",
      "reporter": "thin-reporter"
    },
    {
      "name": "Studio QA required gate",
      "source": ".github/workflows/ci.yml",
      "job": "studio-qa-required-gate",
      "reporter": "thin-reporter"
    },
    {
      "name": "Runtime validation aggregate",
      "source": ".github/workflows/game-runtime-publish.yml",
      "job": "runtime-validation",
      "reporter": "direct"
    },
    {
      "name": "dependency-cruiser boundary lint",
      "source": ".github/workflows/boundaries.yml",
      "job": "lint-boundaries",
      "reporter": "thin-reporter"
    },
    {
      "name": "mirror dry-run (assemble + scrub + gate)",
      "source": ".github/workflows/mirror-multi.yml",
      "job": "dryrun",
      "reporter": "direct"
    },
    {
      "name": "submodule pin reachability + main-ancestry",
      "source": ".github/workflows/submodule-pins.yml",
      "job": "check",
      "reporter": "thin-reporter"
    },
    {
      "name": "mirror publish dry-run (external push)",
      "source": ".github/workflows/mirror-publish-dryrun.yml",
      "job": "publish-dryrun",
      "reporter": "direct"
    },
    {
      "name": "every commit has a human author",
      "source": ".github/workflows/require-human-author.yml",
      "job": "check",
      "reporter": "direct"
    }
  ],
  "governance": {
    "repository": "ForgeaX-Games/forgeax-studio",
    "ref": "main",
    "enforcement": "active",
    "strictRequiredStatusChecks": false,
    "bypassActors": [],
    "currentUserCanBypass": "never"
  },
  "releaseIntegrity": {
    "manifestVersion": "release-integrity.v1",
    "producers": [
      { "producerId": "mirror-forward-producer", "releaseSurface": "mirror-forward", "owner": "producer:mirror-forward", "resultVersion": "release-integrity-result.v1", "trustScope": "ordinary-ci", "sourceWork": "mirror-forward candidate evidence" },
      { "producerId": "trusted-dry-run-producer", "releaseSurface": "trusted-dry-run", "owner": "producer:trusted-dry-run", "resultVersion": "release-integrity-result.v1", "trustScope": "trusted-base-ci", "sourceWork": "trusted-dry-run candidate evidence" },
      { "producerId": "route-back-producer", "releaseSurface": "route-back", "owner": "producer:route-back", "resultVersion": "release-integrity-result.v1", "trustScope": "ordinary-ci", "sourceWork": "route-back candidate evidence" },
      { "producerId": "desktop-producer", "releaseSurface": "desktop", "owner": "producer:desktop", "resultVersion": "release-integrity-result.v1", "trustScope": "ordinary-ci", "sourceWork": "desktop candidate evidence" },
      { "producerId": "game-runtime-producer", "releaseSurface": "game-runtime", "owner": "producer:game-runtime", "resultVersion": "release-integrity-result.v1", "trustScope": "ordinary-ci", "sourceWork": "game-runtime candidate evidence" }
    ],
    "consumers": [
      { "consumerId": "mirror-forward-source-admission", "producerId": "mirror-forward-producer", "releaseSurface": "mirror-forward", "verifierId": "mirror-forward-verifier", "publisherId": "mirror-forward-publisher", "resultVersion": "release-integrity-result.v1", "trustScope": "ordinary-ci", "sourceWork": "mirror-forward source work" },
      { "consumerId": "trusted-dry-run-source-admission", "producerId": "trusted-dry-run-producer", "releaseSurface": "trusted-dry-run", "verifierId": "trusted-dry-run-verifier", "publisherId": "trusted-dry-run-publisher", "resultVersion": "release-integrity-result.v1", "trustScope": "trusted-base-ci", "sourceWork": "trusted-dry-run source work" },
      { "consumerId": "route-back-source-admission", "producerId": "route-back-producer", "releaseSurface": "route-back", "verifierId": "route-back-verifier", "publisherId": "route-back-publisher", "resultVersion": "release-integrity-result.v1", "trustScope": "ordinary-ci", "sourceWork": "route-back source work" },
      { "consumerId": "desktop-source-admission", "producerId": "desktop-producer", "releaseSurface": "desktop", "verifierId": "desktop-verifier", "publisherId": "desktop-publisher", "resultVersion": "release-integrity-result.v1", "trustScope": "ordinary-ci", "sourceWork": "desktop payload source work" },
      { "consumerId": "game-runtime-source-admission", "producerId": "game-runtime-producer", "releaseSurface": "game-runtime", "verifierId": "game-runtime-verifier", "publisherId": "game-runtime-publisher", "resultVersion": "release-integrity-result.v1", "trustScope": "ordinary-ci", "sourceWork": "game-runtime source work" }
    ],
    "edges": [
      { "edgeId": "mirror-forward-source-admission-producer", "from": "mirror-forward-producer", "to": "mirror-forward-verifier", "kind": "verifier" },
      { "edgeId": "mirror-forward-source-admission-publisher", "from": "mirror-forward-verifier", "to": "mirror-forward-publisher", "kind": "publisher" },
      { "edgeId": "trusted-dry-run-source-admission-producer", "from": "trusted-dry-run-producer", "to": "trusted-dry-run-verifier", "kind": "verifier" },
      { "edgeId": "trusted-dry-run-source-admission-publisher", "from": "trusted-dry-run-verifier", "to": "trusted-dry-run-publisher", "kind": "publisher" },
      { "edgeId": "route-back-source-admission-producer", "from": "route-back-producer", "to": "route-back-verifier", "kind": "verifier" },
      { "edgeId": "route-back-source-admission-publisher", "from": "route-back-verifier", "to": "route-back-publisher", "kind": "publisher" },
      { "edgeId": "desktop-source-admission-producer", "from": "desktop-producer", "to": "desktop-verifier", "kind": "verifier" },
      { "edgeId": "desktop-source-admission-publisher", "from": "desktop-verifier", "to": "desktop-publisher", "kind": "publisher" },
      { "edgeId": "game-runtime-source-admission-producer", "from": "game-runtime-producer", "to": "game-runtime-verifier", "kind": "verifier" },
      { "edgeId": "game-runtime-source-admission-publisher", "from": "game-runtime-verifier", "to": "game-runtime-publisher", "kind": "publisher" }
    ]
  }
}
