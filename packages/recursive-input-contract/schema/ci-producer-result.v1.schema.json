{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeax:ci-producer-result:v1",
  "title": "ForgeaX CI producer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "resultVersion",
    "producerId",
    "status",
    "category",
    "code",
    "rootProducer",
    "blockedBy",
    "safeRerun",
    "attempt",
    "timing",
    "metrics",
    "evidence"
  ],
  "properties": {
    "specVersion": { "const": 1 },
    "resultVersion": { "const": "forgeax-ci-producer-result.v1" },
    "producerId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed", "blocked", "superseded"] },
    "category": { "enum": ["product", "contract", "infrastructure", "stochastic", "upstream"] },
    "code": { "type": "string", "minLength": 1 },
    "rootProducer": { "type": "string", "minLength": 1 },
    "blockedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "safeRerun": { "type": "boolean" },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "runId", "runAttempt", "job"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "runAttempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "job": { "type": "string", "minLength": 1 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt"],
      "properties": {
        "queuedAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" },
        "prepareCompletedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "runAttempt", "isRerun"],
      "properties": {
        "queueDurationMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "prepareDurationMs": { "type": "integer", "minimum": 0 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "isRerun": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producers"],
      "properties": {
        "producers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
