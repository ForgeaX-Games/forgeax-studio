{
  "version": 1,
  "sourceRoots": [
    ".github/workflows",
    "scripts/mirror/ci"
  ],
  "requiredSelfHostedLabel": "self-hosted",
  "capacityLabels": [
    "standard",
    "heavy"
  ],
  "hostedRunnerAllowlist": [
    {
      "workflow": ".github/workflows/game-runtime-publish.yml",
      "job": "build-platform",
      "runners": [
        "macos-latest",
        "windows-latest"
      ],
      "dynamicSelfHostedRunners": [
        [
          "self-hosted",
          "Linux",
          "X64",
          "heavy"
        ]
      ],
      "events": [
        "push:tag",
        "schedule",
        "workflow_dispatch"
      ],
      "reason": "Only the scheduled, tagged, or explicitly dispatched low-frequency release lane may use native hosted SDKs; daily PR and branch runs are Linux self-hosted."
    }
  ]
}
